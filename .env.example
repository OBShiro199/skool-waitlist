# Leave the Supabase and Resend values empty to run locally:
# signups are then saved to .data/waitlist.json and emails are printed to the terminal.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server only.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Olly <olly@waitlist.buildsoftwaresolo.com>"
IP_HASH_SALT=change-me
TOKEN_SECRET=change-me
SKOOL_JOIN_URL=https://www.skool.com/build-profitable-software
# waitlist | open | closed
SITE_PHASE=waitlist
# Set to 1 on preview deployments to allow ?phase=open in the URL (always allowed in dev)
NEXT_PUBLIC_ALLOW_PHASE_OVERRIDE=
# Password for the private /waitlist page (set it in Vercel, never in code)
WAITLIST_ADMIN_PASSWORD=
# Where new-signup alerts go
NOTIFY_EMAIL=
