# Leave the Supabase and Resend values empty to run locally:
# signups are then saved to .data/waitlist.json and emails are printed to the terminal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Olly <olly@buildsoftwaresolo.com>"
IP_HASH_SALT=change-me
TOKEN_SECRET=change-me
SKOOL_JOIN_URL=https://www.skool.com/build-profitable-software
# waitlist | open | closed
SITE_PHASE=waitlist
# Set to 1 on preview deployments to allow ?phase=open in the URL (always allowed in dev)
NEXT_PUBLIC_ALLOW_PHASE_OVERRIDE=
